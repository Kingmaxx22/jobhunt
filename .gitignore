# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
lib-cov/
coverage/
*.lcov
.nyc_output/

# Dependencies
node_modules/
jspm_packages/
bower_components/
web_modules/
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# TypeScript / build output
*.tsbuildinfo
.ncc-cache/
dist/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# Caches
.npm/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.fusebox/
.temp/
.docusaurus/
.serverless/
.dynamodb/
.grunt/

# REPL history
.node_repl_history

# Archives
*.tgz

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Wrangler / Cloudflare (local state + secrets live here, never commit)
.wrangler/
.dev.vars*
!.dev.vars.example
.env*
!.env.example
wrangler.local.jsonc

# Personal data: CVs and anything identifying live here, never commit.
# Candidate profile content lives in D1, not in the repo.
cv/
*.pdf
*.doc
*.docx

# Scratch SQL (ad-hoc queries may embed personal data).
# Versioned schema/migrations stay tracked.
*.sql
!migrations/*.sql
